ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/fx_agent

# ── OANDA v20 ─────────────────────────────────────────────────────────────────
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
