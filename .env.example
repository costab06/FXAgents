# ── Interactive Brokers (TWS / IB Gateway) ────────────────────────────────────
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── FIX session (FXSpotStream / direct bank) ──────────────────────────────────
FIX_CONFIG_PATH=fix.cfg

# ── Smart Order Router ────────────────────────────────────────────────────────
SOR_STALE_SECONDS=3.0
SOR_MAX_SLIPPAGE_PIPS=3.0
SOR_ENABLED_FEEDS=["oanda"]
